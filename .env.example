# Скопировать в .env и при необходимости поправить. .env в git не коммитим.

# Порт, на котором nginx отдаёт приложение на хосте
HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=ticket
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket
POSTGRES_PORT=5432

# Как бэкенд (Yii) достаёт БД. Host = имя сервиса в compose.
DB_HOST=postgres
DB_PORT=5432

# Отдельная база для прогона тестов (config/test_db.php)
TEST_DB_NAME=ticket_test

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
