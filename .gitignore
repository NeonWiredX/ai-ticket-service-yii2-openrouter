# Бэкенд: зависимости и рантайм-артефакты.
# Детальные правила — в backend/.gitignore и вложенных runtime/ и web/assets/.
/backend/vendor/
/backend/composer.phar
/backend/runtime/*
!/backend/runtime/.gitignore
/backend/web/assets/*
!/backend/web/assets/.gitignore
/backend/tests/_output/*
